rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Path shape: sites/{siteId}/{ownerId}/{filename}
    // Only the matching authenticated owner can write; anyone can read
    // (uploaded images need to render on published sites).
    match /sites/{siteId}/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                     && request.auth.uid == ownerId
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
    }
  }
}
