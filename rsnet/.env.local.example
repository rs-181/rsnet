# Firebase client config (public, but still keep out of source control)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The public origin sites are published under. Used to build "View live"
# links and shareable URLs (e.g. https://getrs.vercel.app/sites/my-site).
NEXT_PUBLIC_SITE_ORIGIN=https://getrs.vercel.app

# Server-only. The only email allowed into the hidden /rs-secret-dashboard-99x
# admin panel — every other visitor (including other logged-in users) gets a
# plain 404. Never prefix this with NEXT_PUBLIC_.
RS_OWNER_EMAIL=rsandhi37@gmail.com

# Server-only. Full Firebase service-account JSON (as a single-line string)
# for the Admin SDK — used to render public sites, create sites with
# collision-checked URLs, verify session cookies for the admin panel, and
# validate site passwords, all without exposing any of that to public
# Firestore reads.
# Generate from Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-only. Random secret used to sign the "site unlocked" cookie for
# password-protected sites. Generate with: openssl rand -hex 32
RS_SITE_AUTH_SECRET=
