# Firebase client config (public, but still keep out of source control)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The apex domain sites are published under, e.g. rsnet.vercel.app.
# Used by middleware.js to detect and strip wildcard subdomains.
NEXT_PUBLIC_ROOT_DOMAIN=rsnet.vercel.app

# Server-only secret used to gate the hidden /rs-admin-secret route.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-side only.
RS_ADMIN_MASTER_PASSWORD=

# Server-only. Random secret used to sign the admin session cookie, once
# the master password above has been entered. Generate with: openssl rand -hex 32
RS_ADMIN_SESSION_SECRET=

# Server-only. Full Firebase service-account JSON (as a single-line string)
# for the Admin SDK — used to render public sites and validate site
# passwords without exposing Firestore reads to the public client.
# Generate from Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-only. Random secret used to sign the "site unlocked" cookie for
# password-protected sites. Generate with: openssl rand -hex 32
RS_SITE_AUTH_SECRET=
